{{- /* Owned by chezmoi (setup-dev-win). Edit the template, not the applied file.
     Section placement follows https://learn.microsoft.com/en-us/windows/wsl/wsl-config
     (WSL silently ignores a key in the wrong section): telemetry is a [wsl2]
     key, distributionInstallPath is a [general] key. */ -}}
{{- if lt (int .hostMemoryGB) 4 -}}
{{-   fail "hostMemoryGB is below 4: memory detection failed. Refusing to write a .wslconfig." -}}
{{- end -}}
{{- if lt (int .logicalProcessors) 1 -}}
{{-   fail "logicalProcessors is below 1: NUMBER_OF_PROCESSORS was empty or invalid. Refusing to write a .wslconfig." -}}
{{- end -}}
{{- $processors := sub (int .logicalProcessors) 2 -}}
{{- if lt $processors 2 -}}{{- $processors = 2 -}}{{- end -}}
[wsl2]
# Half of host RAM, so the Windows side and the lab VMs keep the rest.
memory={{ div (int .hostMemoryGB) 2 }}GB
# Logical processors minus 2, never below 2: the host stays responsive.
processors={{ $processors }}
# Fixed swap so a runaway build cannot grow the page file unbounded.
swap=16GB
# NAT, never mirrored: the Windows Firewall stays in the path.
networkingMode=nat
# Windows tools reach WSL services on localhost; nothing is exposed to the LAN.
localhostForwarding=true
# Apply Windows Firewall rules to WSL traffic.
firewall=true
# Do not send WSL diagnostics to Microsoft.
telemetry=false

[general]
# Distro VHDs live on the data volume, not the system drive.
distributionInstallPath={{ .wslDistroRoot | replace "\\" "\\\\" }}

[experimental]
# Sparse VHDs return freed space to the host.
sparseVhd=true
# Hand idle page cache back to Windows gradually.
autoMemoryReclaim=gradual
